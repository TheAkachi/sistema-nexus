# Use: node --env-file=.env api/server.mjs
# Nenhum valor real neste arquivo. Na VPS, o .env fica com chmod 600 e cada segredo está descrito no contrato (seção 11).
NODE_ENV=development
# Porta 4184 (a 4190 do começo está na lista de portas bloqueadas do fetch e dos navegadores).
PORT=4184
PUBLIC_ORIGIN=http://127.0.0.1:4184
# Sem DATABASE_URL, PostgreSQL local via PGlite em .runtime/postgres.
# Na VPS: banco e usuário próprios da gestão, nunca os do site.
# No compose integrado, use o nome completo: "db" pode apontar para o banco do site.
# DATABASE_URL=postgresql://USUARIO:SENHA@sistema-nexus-db-1:5432/gestao
# DB_DIR=.runtime/postgres
# Origem pública do site (miniaturas e "Ver no guia") e endereço interno da integração (rede do Docker).
# SITE_PUBLIC_ORIGIN=https://nexus.demo
# SITE_API_URL=http://nexus-app-1:4183
# Segredos (gerar na VPS, nunca versionar):
# TOTP_KEY=            # 32 bytes em hex: cifra os segredos do 2FA no banco
# INTEGRACAO_CHAVE_ID= # nome da chave atual da integração, como k1
# INTEGRACAO_CHAVE=    # 32 bytes em hex, igual no .env do site
# BACKUP_PASSPHRASE=   # 16+ caracteres; só no arquivo do backup diário da VPS
